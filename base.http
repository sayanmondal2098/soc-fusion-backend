@baseUrl = http://localhost:8000
@baseQuery = _request.dummy=1

### Health
GET {{baseUrl}}/health?{{baseQuery}}
Accept: application/json

### VirusTotal single pulse scan (auto-detect indicator type)
POST {{baseUrl}}/virustotal/scan-pulse
Content-Type: application/json

{
  "pulse": "8.8.8.8",
  "indicator_type": "auto"
}

### VirusTotal single pulse scan (explicit URL indicator)
POST {{baseUrl}}/virustotal/scan-pulse
Content-Type: application/json

{
  "pulse": "https://example.org/suspicious",
  "indicator_type": "url"
}

### VirusTotal batch pulse scan (continue on item errors)
POST {{baseUrl}}/virustotal/scan-pulse/batch
Content-Type: application/json

{
  "continue_on_error": true,
  "items": [
    {
      "pulse": "8.8.8.8",
      "indicator_type": "auto"
    },
    {
      "pulse": "example.com",
      "indicator_type": "domain"
    },
    {
      "pulse": "44d88612fea8a8f36de82e1278abb02f",
      "indicator_type": "file"
    },
    {
      "pulse": "https://example.org",
      "indicator_type": "url"
    }
  ]
}
